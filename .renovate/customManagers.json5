{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process app-template schema annotations using the OCI chart version stream",
      managerFilePatterns: ["/helmrelease\\.ya?ml$/"],
      matchStrings: [
        "\\$schema=https://raw\\.githubusercontent\\.com/bjw-s-labs/helm-charts/app-template-(?<currentValue>[^/]+)/charts/other/app-template/schemas/helmrelease-helm-v2\\.schema\\.json",
      ],
      depNameTemplate: "ghcr.io/bjw-s-labs/helm/app-template",
      datasourceTemplate: "docker",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Process annotated container image dependencies (repo:tag@digest)",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "# renovate-image: depName=(?<depName>\\S+)\\n[ \\t]*version:[ \\t]*[^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
  ],
}
